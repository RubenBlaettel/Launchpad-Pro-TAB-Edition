<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath – Artefakt-Konfiguration für Launchpad Pro TAB Edition (Slug: „windows“).
  In SignPath unter Projekt › Artifact Configurations › Add anlegen und diesen Text einfügen.

  Der Release-Workflow (.github/workflows/build.yml) schickt zwei ZIP-Artefakte mit flach
  abgelegten Dateien:
    1. zu-signieren-programm: unsignierte Programmdateien und der Inno-Deinstaller, von
       tools/signing.py durchnummeriert (0001.dll, 0002.exe, …)
    2. zu-signieren-setup:    der fertige Installer LaunchpadProTAB-Setup-x.y.z.exe
  Alle EXE- und DLL-Dateien darin werden mit Authenticode (SHA-256, mit Zeitstempel) signiert.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <include path="*.exe" min-matches="0" max-matches="unbounded" />
      <include path="*.dll" min-matches="0" max-matches="unbounded" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
