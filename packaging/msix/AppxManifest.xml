<?xml version="1.0" encoding="utf-8"?>
<!--
  Vorlage für das Microsoft-Store-Paket (MSIX). tools/build_msix.py füllt die Platzhalter:
  Identität und Anzeigename aus packaging/msix/store.json (Werte aus Partner Center),
  Version aus launchpad_pro_tab/__init__.py (1.2.0 -> 1.2.0.0).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap6="http://schemas.microsoft.com/appx/manifest/uap/windows10/6"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 uap6 desktop rescap">

  <Identity Name="${name}" Publisher="${publisher}" Version="${version}" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>${display_name}</DisplayName>
    <PublisherDisplayName>${publisher_display_name}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>${description}</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="de-DE" />
  </Resources>

  <Applications>
    <Application Id="LaunchpadProTAB" Executable="LaunchpadProTAB.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="${display_name}"
        Description="${description}"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" ShortName="Launchpad Pro" />
      </uap:VisualElements>
      <Extensions>
        <!-- Doppelklick auf projekt.lptab öffnet das Projekt (wie die Dateizuordnung des Installers) -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="lptab">
            <uap:DisplayName>Launchpad-Pro-Projekt</uap:DisplayName>
            <uap:Logo>Assets\FileLogo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.lptab</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <!-- Start per Befehlszeile mit Optionen (z. B. Vollbild); nutzt auch der CI-Test -->
        <uap3:Extension Category="windows.appExecutionAlias" Executable="LaunchpadProTAB.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="LaunchpadProTAB.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Desktop-Programm (Qt/Python) im Paket: nötig für jede Win32-Anwendung -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Extensions>
    <!-- Im Paket wertet Windows PATH beim Laden von DLLs nicht aus. Darüber finden Qt-Plugins
         (z. B. qml\QtQuick\Controls\Basic) sonst ihre Qt-Bibliotheken in _internal\PySide6
         ("Cannot load library … The specified module could not be found"). -->
    <uap6:Extension Category="windows.loaderSearchPathOverride">
      <uap6:LoaderSearchPathOverride>
        <uap6:LoaderSearchPathEntry FolderPath="_internal\PySide6" />
        <uap6:LoaderSearchPathEntry FolderPath="_internal" />
      </uap6:LoaderSearchPathOverride>
    </uap6:Extension>
  </Extensions>
</Package>
